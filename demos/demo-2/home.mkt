// Smart home energy manager node
//
// Aggregates data from solar inverter and battery to compute net grid demand

import inverter
import battery

service home {
  // Calculate solar generation state
  pub def solar_active = inverter.generating;

  // Track battery charge level
  pub def battery_level = battery.charge_level;

  // Reflect the battery operational mode; initially bool, may be updated to string.
  pub def power_source = battery.status;

  // Tracks the current type of power_source as a display string.
  // Updated atomically alongside battery.status by the controller.
  pub def power_source_type = "bool";
}
