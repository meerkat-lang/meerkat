import board
import desk

service sprint {}

@test(sprint) {
    insert {1, "water basil plant", 3, false} into tasks
    insert {2, "respond to email", 10, false} into tasks
    insert {3, "fix lamp", 30, false} into tasks

    assert(desk.backlog_min == 43);
    assert(desk.long_night == true);
}
